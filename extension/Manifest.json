{
  "manifest_version": 3,

  "name": "File Share",

  "version": "1.1.0",

  "description": "Send files from your phone to your computer.",

  "permissions": [
    "sidePanel",
    "storage"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "File Share"
  },

  "side_panel": {
    "default_path": "index.html"
  }
}